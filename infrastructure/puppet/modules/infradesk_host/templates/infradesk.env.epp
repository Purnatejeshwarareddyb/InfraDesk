<%- | Sensitive[String] $secret_key,
      String            $environment,
      Integer           $web_port,
      Boolean           $cookie_secure,
      Integer           $access_token_minutes,
      String            $app_dir,
      String            $backup_dir,
      Integer           $retention_days,
| -%>
# Managed by Puppet (module infradesk_host). Local edits are overwritten on the next apply.
# Read by the systemd backup service (EnvironmentFile) and usable with `set -a; . <file>`.
# Plain KEY=value lines only, no quotes, so that systemd and the shell read them the same way.
SECRET_KEY=<%= $secret_key.unwrap %>
ENVIRONMENT=<%= $environment %>
INFRADESK_PORT=<%= $web_port %>
COOKIE_SECURE=<%= $cookie_secure %>
ACCESS_TOKEN_MINUTES=<%= $access_token_minutes %>
INFRADESK_APP_DIR=<%= $app_dir %>
INFRADESK_BACKUP_DIR=<%= $backup_dir %>
INFRADESK_RETENTION_DAYS=<%= $retention_days %>
