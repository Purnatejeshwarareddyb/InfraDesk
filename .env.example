# InfraDesk configuration. Copy to ".env" and edit. NEVER commit the real .env file.
# `make env` (or scripts/setup_ubuntu.sh) creates .env with a freshly generated SECRET_KEY.

# development | production | test
# "development" allows `seed_demo_data.py`; use "production" for anything shared.
ENVIRONMENT=development

# REQUIRED. The application refuses to start with the placeholder value.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Session lifetime in minutes (5 to 1440).
ACCESS_TOKEN_MINUTES=60

# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false

# Browser origins allowed to call the API with cookies (comma separated).
# Docker Compose serves the site on port 8080, `npm run dev` uses port 5173.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Local development without Docker (relative to the backend folder).
# Inside Docker the database lives on a volume at /data/infradesk.db.
DATABASE_URL=sqlite:///./data/infradesk.db

# Host port published by Docker Compose for the web interface.
INFRADESK_PORT=8080
